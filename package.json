{
  "name": "rae-playwright-mcp",
  "version": "0.0.9",
  "description": "Rae Playwright MCP - Playwright MCP with per-run HAR recording for reverse-api-engineer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalil0321/rae-playwright-mcp.git"
  },
  "homepage": "https://github.com/kalil0321/rae-playwright-mcp",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Microsoft Corporation"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.kalil0321/rae-playwright-mcp",
  "scripts": {
    "lint": "node update-readme.js",
    "test": "playwright test",
    "ctest": "playwright test --project=chrome",
    "ftest": "playwright test --project=firefox",
    "wtest": "playwright test --project=webkit",
    "dtest": "MCP_IN_DOCKER=1 playwright test --project=chromium-docker",
    "build": "echo OK",
    "npm-publish": "npm run lint && npm run test && npm publish",
    "docker-build": "docker build --no-cache -t playwright-mcp-dev:latest .",
    "docker-rm": "docker rm playwright-mcp-dev",
    "docker-run": "docker run -it -p 8080:8080 --name playwright-mcp-dev playwright-mcp-dev:latest",
    "roll": "node roll.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "playwright": "1.64.1",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.3.0"
  },
  "bin": {
    "rae-playwright-mcp": "cli.js",
    "mcp-server-playwright": "cli.js"
  }
}
